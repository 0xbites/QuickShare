# Postgres connection string.
# Free tier: https://neon.tech — create a project and copy the pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Origin used to build share links. No trailing slash.
APP_BASE_URL=http://localhost:3000

PORT=3000

# How long a share link stays alive.
RETENTION_HOURS=24

# Largest accepted upload, in bytes. Default 100 MB.
MAX_UPLOAD_BYTES=104857600

# How often expired rows and their blobs are swept. Default 1 hour.
SWEEP_INTERVAL_MS=3600000


# ---- Abuse controls ----

# Whether to trust X-Forwarded-For when determining the client address.
# Every rate limit is keyed on that address, so both mistakes hurt:
#   unset behind a proxy  -> all clients share one bucket, one user locks out everyone
#   set too broadly       -> clients spoof the header and bypass limits entirely
# Set to 1 on Render (a single proxy in front). Leave off for local development.
TRUST_PROXY=

# Service-wide cap on total stored bytes. Default 5 GB.
STORAGE_CEILING_BYTES=5368709120

# Per-IP request limits. Windows are in milliseconds.
ALLOCATE_RATE_MAX=20
ALLOCATE_RATE_WINDOW_MS=60000
UPLOAD_RATE_MAX=10
UPLOAD_RATE_WINDOW_MS=60000
REPORT_RATE_MAX=5
REPORT_RATE_WINDOW_MS=3600000

# Upper bound on clients tracked per limiter, which bounds memory.
RATE_LIMIT_MAX_KEYS=50000

# Key used to hash reporter IP addresses before storing them.
# Optional: a random value is generated per process if unset, but then hashes
# stop matching across restarts and a repeat spammer cannot be recognised.
IP_HASH_SECRET=
