<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QuickShare</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <main class="card">
    <h1>Nothing here</h1>

    <!-- One page for every failure. An expired link, an unknown link and a
         malformed one all land here with the same wording, so the page cannot
         be used to work out which identifiers exist. -->
    <p class="lede"><%= message %></p>

    <p><a href="/">Share a file</a></p>
  </main>
</body>

</html>
