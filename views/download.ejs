<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QuickShare — download</title>
  <link rel="icon" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>

<!-- The uuid is passed through a data attribute rather than interpolated into
     the script, so no server value is ever parsed as JavaScript. It is also
     needed at decryption time: the uuid is the additional authenticated data
     that binds this ciphertext to this link. -->
<body data-uuid="<%= uuid %>">
  <main class="card">
    <h1>A file is waiting for you</h1>

    <!-- Only the size is shown. The server does not know the filename; it
         appears once your browser has decrypted the file. -->
    <dl class="facts">
      <div>
        <dt>Size</dt>
        <dd><%= (sizeBytes / 1024).toFixed(1) %> KB encrypted</dd>
      </div>
      <div>
        <dt>Expires</dt>
        <dd><%= expiresAt.toISOString().replace('T', ' ').slice(0, 16) %> UTC</dd>
      </div>
    </dl>

    <button type="button" id="download-button">Download and decrypt</button>

    <p class="note">Decryption happens in this browser. The key came from the link and was never sent to the server.</p>
    <p id="status" role="status" aria-live="polite"></p>

    <!-- Nobody can inspect what this file contains, so a report is the only way
         the operator ever learns something needs removing. Collapsed by default
         to stay out of the way, and it sends only the uuid and the reason —
         never the key, which this page holds. -->
    <details class="report">
      <summary>Report this file</summary>
      <form id="report-form">
        <textarea id="report-reason" rows="3" maxlength="500" required
                  placeholder="What is wrong with this file?"></textarea>
        <button type="submit">Send report</button>
      </form>
      <p id="report-status" role="status" aria-live="polite"></p>
    </details>
  </main>

  <script type="module" src="/js/download.js"></script>
</body>

</html>
